# -----------------------------
# Operating System
# -----------------------------

.DS_Store
.DS_Store?
Thumbs.db
desktop.ini

# -----------------------------
# Editors / IDEs
# -----------------------------

.vscode/
.idea/
*.swp
*.swo
*~

# Keep VS Code settings only if intentionally shared.
# If you want to share specific settings, add them explicitly later.

# -----------------------------
# Environment / Secrets
# -----------------------------

.env
.env.*
!.env.example

# -----------------------------
# Dependencies
# -----------------------------

node_modules/
vendor/

# -----------------------------
# Build / Generated Files
# -----------------------------

dist/
build/
out/
coverage/
.cache/
.temp/
tmp/

# -----------------------------
# Logs
# -----------------------------

*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# -----------------------------
# Local Development
# -----------------------------

*.local
*.local.*