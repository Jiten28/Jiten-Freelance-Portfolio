<!-- ================= DIGITAL MENU EXPERIENCES ================= -->
<section class="dark-section">
  <div class="wrap">
    <div class="section-head">
      <span class="kicker">Future Menu Experiences</span>
      <h2>Digital Menu Experiences</h2>
      <p>Digital menus are a separate product category from client projects. They represent Jiten Labs' service offerings for creating modern, QR-accessible dining experiences.</p>
    </div>

    <!-- Digital Menu Architecture Overview -->
    <div class="menu-architecture">
      <h3>How It Works</h3>
      <div class="menu-flow">
        <!-- Normal Digital Menu Flow -->
        <div class="menu-flow-item">
          <h4>Normal Digital Menu</h4>
          <div class="flow-step qr-code">QR Code</div>
          <div class="flow-arrow">→</div>
          <div class="flow-step menu-landing">Menu Landing Page</div>
          <div class="flow-arrow">→</div>
          <div class="flow-step menu-experience">Menu Experience</div>
          <div class="flow-actions">
            <span class="action-item">View Digital Menu</span>
            <span class="action-item">View/Download PDF</span>
            <span class="action-item">Share</span>
            <span class="action-item">WhatsApp</span>
            <span class="action-item">Call</span>
            <span class="action-item">Location</span>
          </div>
        </div>

        <!-- AR Digital Menu Flow -->
        <div class="menu-flow-item">
          <h4>AR Digital Menu</h4>
          <div class="flow-step qr-code">QR Code</div>
          <div class="flow-arrow">→</div>
          <div class="flow-step menu-landing">Menu Landing Page</div>
          <div class="flow-arrow">→</div>
          <div class="flow-step decision">Normal Menu / View in AR</div>
          <div class="flow-arrow">→</div>
          <div class="flow-step device-check">Device Support Check</div>
          <div class="flow-arrow">→</div>
          <div class="flow-step ar-branch">AR Experience</div>
          <div class="flow-arrow">→</div>
          <div class="flow-step ar-fallback">Normal Menu Fallback</div>
        </div>
      </div>
    </div>

    <!-- Data Architecture -->
    <div class="menu-data-architecture">
      <h3>Data-Driven Architecture</h3>
      <p>One shared data structure supports multiple menu formats:</p>
      <div class="data-flow">
        <div class="data-source">Business & Menu Data</div>
        <div class="data-arrow">↓</div>
        <div class="data-output">A4 Printable Menu</div>
        <div class="data-arrow">↓</div>
        <div class="data-output">PDF Menu</div>
        <div class="data-arrow">↓</div>
        <div class="data-output">Normal Web Menu</div>
        <div class="data-arrow">↓</div>
        <div class="data-output">AR Menu</div>
        <div class="data-arrow">↓</div>
        <div class="data-output">Future Integrations</div>
      </div>
    </div>

    <!-- Service Distinction -->
    <div class="menu-service-note">
      <h3>Service vs Portfolio</h3>
      <p><strong>Featured Projects:</strong> Real completed client work</p>
      <p><strong>Digital Menu Experiences:</strong> Jiten Labs service offerings</p>
      <p>These experiences represent what we can build for you — not completed projects in our portfolio.</p>
    </div>
  </div>
</section>

