<!DOCTYPE html>
<!-- TEST EDIT WORKING -->
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Jiten Kumar | Web Developer &amp; Digital Solutions | JITEN LABS</title>
<meta name="description" content="Jiten Kumar builds modern business websites, digital menus, e-commerce websites, AI applications and custom digital solutions for businesses and startups.">
<meta property="og:title" content="JITEN LABS — Digital Experiences. Built for Business.">
<meta property="og:description" content="Modern websites, digital menus, e-commerce and custom web applications for real businesses.">
<meta property="og:type" content="website">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%230A0A0C'/%3E%3Cpath d='M20 16h8v20a10 10 0 0 1-10 10H16v-7h2a3 3 0 0 0 3-3V16z' fill='%23C9A96A'/%3E%3Cpath d='M36 16h7v13l10-13h8L49 30l12 16h-8l-8-11-3 4v7h-7V16z' fill='%238A6E3C'/%3E%3C/svg%3E">
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="css/style.css">
<script src="js/data.js"></script>
<script src="js/main.js"></script>

  /* ---------- NAV ---------- */
  header.site-nav{
    position:sticky;top:0;z-index:100;
    background:rgba(8,11,20,0.82);
    backdrop-filter:blur(14px);
    border-bottom:1px solid var(--line);
  }
  .nav-inner{
    max-width:var(--maxw);margin:0 auto;padding:0 clamp(20px,5vw,40px);
    height:72px;display:flex;align-items:center;justify-content:space-between;
  }
  .brand{display:flex;align-items:center;gap:12px;color:var(--text-hi);}
  .brand svg{width:38px;height:38px;flex:0 0 auto;}
  .brand-name{font-family:"Manrope";font-weight:600;font-size:1.05rem;letter-spacing:0.01em;}
  .brand-name span{color:var(--text-mid);font-weight:400;font-size:0.72rem;display:block;letter-spacing:0.08em;}
  nav.links{display:flex;gap:28px;align-items:center;}
  nav.links a{color:var(--text-mid);font-size:0.92rem;transition:color .2s;position:relative;padding:4px 0;}
  nav.links a::before,nav.links a::after{
    content:"";position:absolute;left:0;width:0;height:1px;background:var(--grad);transform:scaleX(0);transition:transform .32s ease;
  }
  nav.links a::before{top:0;}
  nav.links a::after{bottom:0;}
  nav.links a:hover, nav.links a:focus-visible{color:var(--text-hi);}
  nav.links a:hover::before, nav.links a:focus-visible::before,
  nav.links a:hover::after, nav.links a:focus-visible::after{transform:scaleX(1);}
  .cta-btn{
    background:var(--grad);color:#fff;padding:11px 22px;border-radius:999px;font-weight:600;
    font-size:0.9rem;border:none;display:inline-block;transition:transform .2s, box-shadow .2s;
  }
  .cta-btn:hover{transform:translateY(-1px);box-shadow:0 4px 6px -1px rgba(0,0,0,0.1);}
  .ghost-btn{
    background:transparent;color:var(--text-hi);padding:11px 22px;border-radius:999px;font-weight:600;
    font-size:0.9rem;border:1px solid rgba(255,255,255,0.18);
  }
  .ghost-btn.on-light{color:var(--text-ink);border-color:var(--paper-line);}
  .hamburger{display:none;background:none;border:none;color:var(--text-hi);padding:8px;width:40px;height:40px;}
  .hamburger .bars{position:relative;width:22px;height:16px;margin:0 auto;}
  .hamburger .bars span{
    position:absolute;left:0;width:100%;height:2px;background:currentColor;border-radius:2px;
    transition:transform .35s ease, opacity .25s ease, top .35s ease;
  }
  .hamburger .bars span:nth-child(1){top:0;}
  .hamburger .bars span:nth-child(2){top:7px;}
  .hamburger .bars span:nth-child(3){top:14px;}
  .hamburger.open .bars span:nth-child(1){top:7px;transform:rotate(45deg);}
  .hamburger.open .bars span:nth-child(2){opacity:0;}
  .hamburger.open .bars span:nth-child(3){top:7px;transform:rotate(-45deg);}
  .mobile-menu{
    display:none;flex-direction:column;gap:2px;background:var(--navy-2);border-bottom:1px solid var(--line);
    overflow:hidden;
  }
  .mobile-menu.open{display:flex;}
  .mobile-menu a{
    padding:14px 24px;color:var(--text-mid);border-bottom:1px solid var(--line);
    opacity:0;transform:translateY(-8px);transition:opacity .3s ease, transform .3s ease, color .2s;
  }
  .mobile-menu a:last-child{border-bottom:none;}
  .mobile-menu.open a{opacity:1;transform:translateY(0);}
  .mobile-menu.open a:nth-child(1){transition-delay:.04s;}
  .mobile-menu.open a:nth-child(2){transition-delay:.08s;}
  .mobile-menu.open a:nth-child(3){transition-delay:.12s;}
  .mobile-menu.open a:nth-child(4){transition-delay:.16s;}
  .mobile-menu.open a:nth-child(5){transition-delay:.2s;}
  .mobile-menu.open a:nth-child(6){transition-delay:.24s;}
  .mobile-menu.open a:nth-child(7){transition-delay:.28s;}
  .mobile-menu a:hover{color:var(--text-hi);}

  @media (max-width:860px){
    nav.links{display:none;}
    header.site-nav .nav-inner .cta-btn{display:none;}
    .hamburger{display:inline-flex;}
  }

  /* ---------- HERO ---------- */
  .hero{
    position:relative;overflow:hidden;
    padding-top:clamp(70px,12vw,130px);padding-bottom:clamp(70px,12vw,130px);
    background:
      radial-gradient(1100px 500px at 15% -10%, rgba(201,169,106,0.28), transparent 60%),
      radial-gradient(900px 500px at 90% 10%, rgba(138,110,60,0.22), transparent 55%),
      var(--ink);
  }
  .hero-grid{display:grid;grid-template-columns:1.1fr 0.9fr;gap:clamp(30px,5vw,60px);align-items:center;}
  @media (max-width:940px){.hero-grid{grid-template-columns:1fr;}}
  .eyebrow-pill{
    display:inline-flex;align-items:center;gap:8px;padding:7px 14px;border-radius:999px;
    background:rgba(255,255,255,0.06);border:1px solid var(--line);color:var(--text-mid);font-size:0.82rem;margin-bottom:26px;
  }
  .eyebrow-pill i{width:6px;height:6px;border-radius:50%;background:var(--blue);display:inline-block;}
  .hero h1{
    font-size:clamp(2.4rem,5.4vw,4.1rem);color:var(--text-hi);font-weight:600;
  }
  .hero h1 .accent{background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent;}
  .hero p.lede{
    margin-top:24px;color:var(--text-mid);font-size:1.08rem;line-height:1.65;max-width:52ch;
  }
  .hero-ctas{display:flex;gap:14px;margin-top:34px;flex-wrap:wrap;}

  .device-stack{position:relative;height:clamp(320px,42vw,460px);}
  .device-browser{
    position:absolute;top:0;left:0;width:88%;border-radius:14px;overflow:hidden;
    background:var(--panel);border:1px solid var(--line);box-shadow:0 30px 70px -30px rgba(0,0,0,0.7);
  }
  .device-browser .bar{height:32px;display:flex;align-items:center;gap:6px;padding:0 12px;background:rgba(255,255,255,0.03);border-bottom:1px solid var(--line);}
  .device-browser .bar span{width:9px;height:9px;border-radius:50%;background:rgba(255,255,255,0.18);}
  .device-browser .screen{aspect-ratio:16/10;background:linear-gradient(135deg, rgba(201,169,106,0.18), rgba(138,110,60,0.14));position:relative;}
  .device-browser .screen .ui-block{position:absolute;border-radius:8px;background:rgba(255,255,255,0.08);}
  .device-phone{
    position:absolute;bottom:0;right:0;width:38%;aspect-ratio:9/18;border-radius:26px;
    background:var(--panel);border:1px solid var(--line);box-shadow:0 30px 60px -25px rgba(0,0,0,0.75);
    padding:10px;
  }
  .device-phone .screen{width:100%;height:100%;border-radius:18px;background:linear-gradient(160deg, rgba(138,110,60,0.22), rgba(201,169,106,0.14));position:relative;overflow:hidden;}
  .float-chip{
    position:absolute;background:rgba(20,27,54,0.9);border:1px solid var(--line);border-radius:12px;
    padding:9px 13px;font-size:0.76rem;color:var(--text-hi);backdrop-filter:blur(6px);
    box-shadow:0 15px 30px -12px rgba(0,0,0,0.6);
  }
  .float-chip.c1{top:8%;left:-8%;}
  .float-chip.c2{bottom:14%;left:2%;}
  @media (prefers-reduced-motion: no-preference){
    .device-stack{animation:none;}
    .float-chip.c1{animation:floaty 6s ease-in-out infinite;}
    .float-chip.c2{animation:floaty 7s ease-in-out infinite 1s;}
  }
  @keyframes floaty{0%,100%{transform:translateY(0);}50%{transform:translateY(-9px);}}

  /* ---------- VALUE PROP ---------- */
  .value-grid{display:grid;grid-template-columns:1fr 1fr;gap:50px;align-items:start;}
  @media (max-width:800px){.value-grid{grid-template-columns:1fr;}}
  .value-grid h2{font-size:clamp(1.7rem,3.4vw,2.4rem);}
  .chip-row{display:flex;flex-wrap:wrap;gap:10px;margin-top:26px;}
  .chip{padding:9px 16px;border-radius:999px;background:#fff;border:1px solid var(--paper-line);font-size:0.86rem;font-weight:500;box-shadow:0 1px 0 rgba(10,14,30,0.03);}
  .value-grid .lede{color:var(--text-ink-mid);font-size:1.05rem;line-height:1.7;}

  /* ---------- SERVICES ---------- */
  .section-head{max-width:640px;margin-bottom:48px;}
  .section-head .kicker{color:var(--blue);font-weight:600;font-size:0.9rem;margin-bottom:10px;display:block;}
  .section-head h2{font-size:clamp(1.8rem,3.6vw,2.5rem);}
  .section-head p{margin-top:14px;color:var(--text-ink-mid);font-size:1.02rem;line-height:1.6;}
  .dark-section .section-head p{color:var(--text-mid);}

  .service-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;}
  @media (max-width:980px){.service-grid{grid-template-columns:1fr 1fr;}}
  @media (max-width:560px){.service-grid{grid-template-columns:1fr;}}
  .service-card{ perspective:1400px; height:230px; }
  .flip-inner{
    position:relative;width:100%;height:100%;transition:transform .6s cubic-bezier(.2,.7,.3,1);
    transform-style:preserve-3d;
  }
  .service-card:hover .flip-inner, .service-card:focus-within .flip-inner{transform:rotateY(180deg);}
  .flip-face{
    position:absolute;inset:0;backface-visibility:hidden;border-radius:var(--radius);
    padding:26px 22px;display:flex;flex-direction:column;gap:14px;border:1px solid var(--paper-line);
  }
  .flip-front{background:#fff;}
  .flip-back{background:var(--ink);color:var(--text-hi);transform:rotateY(180deg);justify-content:center;}
  .service-icon{width:44px;height:44px;border-radius:12px;background:var(--grad);display:flex;align-items:center;justify-content:center;color:#0A0A0C;flex:0 0 auto;}
  .service-card h3{font-size:1.12rem;}
  .flip-front p{color:var(--text-ink-mid);font-size:0.86rem;line-height:1.5;}
  .flip-back p{color:var(--text-mid);font-size:0.9rem;line-height:1.55;}
  .flip-back .card-cta{font-size:0.86rem;font-weight:600;color:var(--blue);margin-top:4px;}
  @media (max-width:700px){
    /* touch devices: tap to flip */
    .service-card{height:auto;perspective:none;}
    .flip-inner{transform:none !important;}
    .flip-face{position:relative;inset:auto;}
    .service-card.tapped .flip-inner{transform:rotateY(180deg);}
  }

  /* ---------- PROJECTS ---------- */
  .proj-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;}
  @media (max-width:980px){.proj-grid{grid-template-columns:1fr 1fr;}}
  @media (max-width:640px){.proj-grid{grid-template-columns:1fr;}}
  .proj-card{
    position:relative;border-radius:var(--radius);overflow:hidden;background:var(--panel);
    border:1px solid var(--line);cursor:pointer;
  }
  .proj-thumb{aspect-ratio:16/10;overflow:hidden;background:#0d1224;position:relative;}
  .proj-thumb img{
    width:100%;height:100%;object-fit:cover;object-position:top;
    transition:transform .4s, filter .35s;
    outline:2px solid transparent;outline-offset:-14px;filter:brightness(0.82);
  }
  .proj-card:hover .proj-thumb img, .proj-card:focus-within .proj-thumb img{
    transform:scale(1.04);filter:brightness(1);outline:2px solid var(--blue);outline-offset:-8px;
  }
  .proj-card:hover .proj-thumb::before, .proj-card:focus-within .proj-thumb::before{
    content:"";
    position:absolute;
    top:0;
    left:0;
    right:0;
    height:20px;
    background:linear-gradient(to bottom, rgba(255,255,255,0.1), rgba(0,0,0,0.05));
    border-bottom:1px solid rgba(255,255,255,0.2);
  }
  .proj-body{padding:18px 20px 20px;}
  .proj-body h3{color:var(--text-hi);font-size:1.02rem;}
  .proj-tag{color:var(--text-dim);font-size:0.78rem;margin-top:4px;display:block;}
  .proj-overlay{
    position:absolute;inset:0;background:linear-gradient(180deg, rgba(8,11,20,0.15) 0%, rgba(8,11,20,0.96) 78%);
    display:flex;flex-direction:column;justify-content:flex-end;padding:22px;opacity:0;transition:opacity .25s;
  }
  .proj-card:hover .proj-overlay, .proj-card:focus-within .proj-overlay, .proj-card.tapped .proj-overlay{opacity:1;}
  .proj-overlay h3{color:var(--text-hi);}
  .proj-overlay .tech{color:var(--text-mid);font-size:0.8rem;margin-top:8px;line-height:1.5;}
  .proj-overlay .desc{color:var(--text-mid);font-size:0.85rem;margin-top:8px;line-height:1.55;}
  .proj-overlay .live-btn{margin-top:14px;display:inline-block;background:var(--grad);color:#fff;font-size:0.82rem;font-weight:600;padding:9px 16px;border-radius:999px;width:fit-content;}
  .proj-overlay .note{color:var(--text-dim);font-size:0.72rem;margin-top:8px;}
  .more-projects{margin-top:34px;}
  .tag-list{display:flex;flex-wrap:wrap;gap:10px;}
  .tag-pill{padding:9px 15px;border-radius:10px;background:var(--panel);border:1px solid var(--line);color:var(--text-mid);font-size:0.84rem;}

  /* ---------- FEEDBACK ---------- */
  .feedback-box{
    border:1px dashed var(--paper-line);border-radius:var(--radius);padding:56px 30px;text-align:center;
    background:linear-gradient(135deg, rgba(201,169,106,0.05), rgba(138,110,60,0.05));
  }
  .feedback-box h3{font-size:1.3rem;}
  .feedback-box p{margin-top:10px;color:var(--text-ink-mid);max-width:46ch;margin-left:auto;margin-right:auto;}

  /* ---------- STYLES GALLERY ---------- */
  .style-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;perspective:1200px;}
  @media (max-width:980px){.style-grid{grid-template-columns:1fr 1fr;}}
  @media (max-width:560px){.style-grid{grid-template-columns:1fr;}}
  .style-card{
    background:#fff;border:1px solid var(--paper-line);border-radius:var(--radius);overflow:hidden;
    transition:border-color .2s, box-shadow .3s, transform .3s, opacity .3s; display:flex;flex-direction:column;
    transform-style:preserve-3d;
    tabindex:0;
  }
  .style-card:hover,.style-card:focus-within{transform:rotateX(4deg) rotateZ(-0.6deg) translateY(-6px);box-shadow:0 26px 46px -26px rgba(20,18,10,0.35);z-index:2;}
  .style-grid.has-hover .style-card:not(:hover){opacity:0.55;}
  .style-card.selected{border-color:var(--blue);box-shadow:0 0 0 3px rgba(201,169,106,0.18);}
  .style-mini{aspect-ratio:4/3;position:relative;}
  .style-body{padding:16px 16px 18px;flex:1;display:flex;flex-direction:column;gap:6px;}
  .style-body h4{font-size:0.98rem;}
  .style-body .fit{font-size:0.78rem;color:var(--text-dim);}
  .style-body p{font-size:0.84rem;color:var(--text-ink-mid);line-height:1.45;flex:1;}
  .style-pick{
    margin-top:8px;padding:8px 12px;border-radius:8px;border:1px solid var(--paper-line);background:var(--paper);
    font-size:0.8rem;font-weight:600;text-align:center;
  }
  .style-card.selected .style-pick{background:var(--grad);color:#fff;border-color:transparent;}

  /* ---------- EXPERIENCE ---------- */
  .exp-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;}
  @media (max-width:860px){.exp-grid{grid-template-columns:1fr 1fr;}}
  @media (max-width:520px){.exp-grid{grid-template-columns:1fr;}}
  .exp-card{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:22px;color:var(--text-hi);}
  .exp-card .dot{width:8px;height:8px;border-radius:50%;background:var(--blue);display:inline-block;margin-bottom:12px;}
  .exp-card h4{font-size:0.98rem;}
  .exp-card p{color:var(--text-mid);font-size:0.84rem;margin-top:6px;line-height:1.5;}

  /* ---------- PRICING ---------- */
  .price-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;}
  @media (max-width:980px){.price-grid{grid-template-columns:1fr 1fr;}}
  @media (max-width:560px){.price-grid{grid-template-columns:1fr;}}
  .price-card{background:#fff;border:1px solid var(--paper-line);border-radius:var(--radius);padding:26px 22px;display:flex;flex-direction:column;}
  .price-card.hi{border-color:transparent;position:relative;isolation:isolate;overflow:hidden;transition:transform .3s;}
  .price-card.hi::before{content:"Most Picked";position:absolute;top:-11px;right:20px;background:var(--grad);color:#0A0A0C;font-size:0.7rem;font-weight:700;padding:4px 10px;border-radius:999px;z-index:2;}
  .price-card.hi::after{
    content:"";position:absolute;inset:-2px;border-radius:var(--radius);padding:2px;
    background:var(--grad);
    -webkit-mask:linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite:xor;mask-composite:exclude;
    filter:blur(0px);opacity:0.85;transition:filter .35s, opacity .35s;z-index:1;
  }
  .price-card.hi:hover{transform:translateY(-6px);}
  .price-card.hi:hover::after{filter:blur(3px);opacity:1;}
  .price-card.hi > *{position:relative;z-index:2;}
  .price-card.hi{background:linear-gradient(#fff,#fff) padding-box;}
  .price-card h3{font-size:1.02rem;}
  .price-amt{font-family:"Manrope";font-size:2rem;margin-top:10px;}
  .price-list{list-style:none;padding:0;margin:18px 0 0;display:flex;flex-direction:column;gap:9px;flex:1;}
  .price-list li{font-size:0.86rem;color:var(--text-ink-mid);padding-left:20px;position:relative;}
  .price-list li::before{content:"";position:absolute;left:0;top:6px;width:8px;height:8px;border-radius:2px;background:var(--grad);}
  .price-note{margin-top:26px;color:var(--text-ink-mid);font-size:0.88rem;text-align:center;}

  /* ---------- HOW IT WORKS ---------- */
  .steps-row{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;}
  @media (max-width:860px){.steps-row{grid-template-columns:1fr 1fr;}}
  @media (max-width:520px){.steps-row{grid-template-columns:1fr;}}
  .step-card{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:24px;color:var(--text-hi);}
  .step-num{font-family:"Manrope";font-size:1.6rem;color:var(--blue);}
  .step-card h4{margin-top:10px;font-size:1rem;}

  /* ---------- WHY / ABOUT ---------- */
  .why-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;}
  @media (max-width:860px){.why-grid{grid-template-columns:1fr 1fr;}}
  @media (max-width:520px){.why-grid{grid-template-columns:1fr;}}
  .why-item{padding:20px;border:1px solid var(--paper-line);border-radius:12px;background:#fff;}
  .why-item h4{font-size:0.94rem;}
  .about-grid{display:grid;grid-template-columns:0.9fr 1.4fr;gap:50px;align-items:center;}
  @media (max-width:800px){.about-grid{grid-template-columns:1fr;}}
  .about-avatar{
    width:100%;aspect-ratio:1;border-radius:20px;background:linear-gradient(135deg, rgba(201,169,106,0.22), rgba(138,110,60,0.18));
    border:1px solid var(--paper-line);display:flex;align-items:center;justify-content:center;
  }
  .about-avatar svg{width:46%;height:46%;}

  /* ---------- PLANNER ---------- */
  .planner-shell{background:#fff;border:1px solid var(--paper-line);border-radius:20px;padding:clamp(22px,4vw,44px);box-shadow:0 30px 70px -45px rgba(0,0,0,0.25);}
  .planner-progress{display:flex;gap:6px;margin-bottom:30px;flex-wrap:wrap;}
  .planner-progress .seg{height:5px;border-radius:3px;background:var(--paper-line);flex:1;min-width:16px;}
  .planner-progress .seg.done{background:var(--grad);}
  .planner-step-label{color:var(--text-dim);font-size:0.8rem;font-weight:600;letter-spacing:0.03em;margin-bottom:6px;}
  .planner-step h3{font-size:1.35rem;margin-bottom:22px;}
  .opt-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;}
  @media (max-width:700px){.opt-grid{grid-template-columns:1fr 1fr;}}
  @media (max-width:460px){.opt-grid{grid-template-columns:1fr;}}
  .opt-btn{
    padding:16px 14px;border-radius:12px;border:1.5px solid var(--paper-line);background:var(--paper);text-align:left;
    font-size:0.92rem;font-weight:600;transition:border-color .2s, background .2s;
  }
  .opt-btn:hover{border-color:var(--blue);}
  .opt-btn.selected{border-color:var(--blue);background:linear-gradient(135deg, rgba(201,169,106,0.08), rgba(138,110,60,0.06));color:var(--blue);}
  .opt-btn small{display:block;font-weight:400;color:var(--text-dim);font-size:0.76rem;margin-top:3px;}
  .field-row{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px;}
  @media (max-width:600px){.field-row{grid-template-columns:1fr;}}
  label{font-size:0.84rem;font-weight:600;color:var(--text-ink-mid);display:block;margin-bottom:6px;}
  input[type=text],input[type=tel],input[type=email],textarea,select{
    width:100%;padding:12px 14px;border-radius:10px;border:1.5px solid var(--paper-line);font-family:inherit;font-size:0.94rem;background:var(--paper);
  }
  input:focus,textarea:focus,select:focus,.opt-btn:focus-visible,.style-pick:focus-visible{outline:2px solid var(--blue);outline-offset:2px;}
  textarea{min-height:90px;resize:vertical;}
  .planner-nav{display:flex;justify-content:space-between;margin-top:30px;gap:12px;flex-wrap:wrap;}
  .btn-plain{background:var(--paper);border:1.5px solid var(--paper-line);padding:12px 22px;border-radius:999px;font-weight:600;font-size:0.9rem;}
  .btn-plain:disabled{opacity:0.4;cursor:not-allowed;}

  .summary-block{border:1px solid var(--paper-line);border-radius:14px;padding:20px 22px;margin-bottom:14px;}
  .summary-block h4{font-size:0.86rem;text-transform:uppercase;letter-spacing:0.05em;color:var(--text-dim);margin-bottom:10px;}
  .summary-block .row{display:flex;justify-content:space-between;gap:14px;padding:6px 0;font-size:0.92rem;border-top:1px solid var(--paper-line);}
  .summary-block .row:first-of-type{border-top:none;}
  .summary-block .row span:first-child{color:var(--text-ink-mid);}
  .summary-block .row span:last-child{font-weight:600;text-align:right;}
  .disclaimer{font-size:0.8rem;color:var(--text-dim);margin-top:6px;line-height:1.5;}

  .ai-preview-box{border:1px solid var(--paper-line);border-radius:14px;padding:24px;margin-top:6px;}
  .ai-concept-card{
    margin-top:16px;border-radius:14px;padding:26px;color:#fff;position:relative;overflow:hidden;
  }
  .ai-concept-card .badge{position:absolute;top:14px;right:14px;background:rgba(255,255,255,0.18);font-size:0.68rem;padding:4px 10px;border-radius:999px;font-weight:700;letter-spacing:0.03em;}
  .ai-concept-card h4{font-size:1.05rem;}
  .ai-concept-card .palette{display:flex;gap:8px;margin-top:14px;}
  .ai-concept-card .swatch{width:30px;height:30px;border-radius:8px;border:1px solid rgba(255,255,255,0.3);}
  .ai-concept-card p{color:rgba(255,255,255,0.88);font-size:0.86rem;margin-top:12px;line-height:1.55;}
  .action-row{display:flex;gap:12px;margin-top:16px;flex-wrap:wrap;}

  .deploy-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
  @media (max-width:600px){.deploy-grid{grid-template-columns:1fr;}}

  .final-actions{display:flex;flex-wrap:wrap;gap:14px;margin-top:10px;}
  .final-actions .cta-btn.on-light{color:#fff;}
  .whatsapp-preview{
    background:var(--paper);border:1px solid var(--paper-line);border-radius:12px;padding:18px;
    font-family:ui-monospace,Menlo,monospace;font-size:0.82rem;white-space:pre-wrap;color:var(--text-ink);line-height:1.6;max-height:340px;overflow:auto;
  }

  /* ---------- CONTACT / FOOTER ---------- */
  .contact-cta h2{font-size:clamp(1.9rem,4vw,2.9rem);color:var(--text-hi);max-width:16ch;}
  .contact-cta p{color:var(--text-mid);margin-top:16px;font-size:1.05rem;max-width:48ch;}
  .contact-info{display:flex;flex-wrap:wrap;gap:26px;margin-top:36px;}
  .contact-info a{color:var(--text-mid);font-size:0.92rem;border-bottom:1px solid transparent;}
  .contact-info a:hover{color:var(--text-hi);border-color:var(--text-hi);}

  footer{background:var(--ink);color:var(--text-dim);padding:50px 0 26px;border-top:1px solid var(--line);}
  .footer-grid{display:flex;justify-content:space-between;flex-wrap:wrap;gap:30px;}
  .footer-links{display:flex;gap:20px;flex-wrap:wrap;font-size:0.86rem;}
  .footer-links a{position:relative;padding:3px 0;transition:color .2s;}
  .footer-links a::before,.footer-links a::after{content:"";position:absolute;left:0;width:0;height:1px;background:var(--grad);transition:width .3s ease;}
  .footer-links a::before{top:0;} .footer-links a::after{bottom:0;}
  .footer-links a:hover{color:var(--text-hi);}
  .footer-links a:hover::before,.footer-links a:hover::after{width:100%;}

  .social-row{display:flex;gap:12px;margin-top:16px;}
  .social-icon{
    width:38px;height:38px;border-radius:50%;border:1px solid var(--line);display:flex;align-items:center;justify-content:center;
    position:relative;overflow:hidden;color:var(--text-mid);transition:color .3s, border-color .3s, transform .5s;
  }
  .social-icon svg{width:16px;height:16px;position:relative;z-index:1;transition:transform .5s;}
  .social-icon::before{
    content:"";position:absolute;inset:0;background:var(--grad);border-radius:50%;
    transform:translateY(100%);transition:transform .35s ease;
  }
  .social-icon:hover::before,.social-icon:focus-visible::before{transform:translateY(0);}
  .social-icon:hover,.social-icon:focus-visible{color:#0A0A0C;border-color:transparent;}
  .social-icon:hover svg,.social-icon:focus-visible svg{transform:rotateY(360deg);}
  .footer-bottom{margin-top:36px;padding-top:20px;border-top:1px solid var(--line);font-size:0.8rem;display:flex;justify-content:space-between;flex-wrap:wrap;gap:10px;}

  .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;}
  .skip-link{
    position:absolute;
    top:-40px;
    left:0;
    background:#fff;
    color:#000;
    padding:8px;
    z-index:100;
    border-radius:0 0 4px 4px;
    transition:top .3s;
  }
  .skip-link:focus{
    top:0;
  }
  .visually-hide-desktop{display:none;}
  @media (max-width:700px){
    .visually-hide-mobile{display:none;}
    .visually-hide-desktop{display:block;}
  }
</style>
</head>
<body>
